---
/**
 * Ofertas o formatos como tarjetas horizontales: nombre grande a la izquierda,
 * descripción, etiquetas y enlace a la derecha. Luz que sigue al cursor.
 */
import Arrow from '@/components/ui/Arrow.astro';

interface Row {
  title: string;
  text: string;
  list?: string[];
  href?: string;
  linkLabel?: string;
}
interface Props {
  id: string;
  title: string;
  intro?: string;
  rows: Row[];
  theme?: 'ground' | 'surface' | 'dark';
}
const { id, title, intro, rows, theme = 'ground' } = Astro.props;
---

<section class="rows section" aria-labelledby={id} data-theme={theme === 'ground' ? undefined : theme}>
  <div class="wrap">
    <div class="rows__head">
      <h2 id={id} class="t-head rows__title" data-split>{title}</h2>
      {intro && <p class="t-lead rows__intro">{intro}</p>}
    </div>
    <div class="rows__list">
      {
        rows.map((r) => (
          <article class="row" data-spotlight data-reveal="self">
            <h3 class="row__title">{r.title}</h3>
            <div class="row__body">
              <p class="row__text">{r.text}</p>
              {r.list && (
                <ul class="row__tags">
                  {r.list.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              )}
              {r.href && (
                <a class="row__link" href={r.href}>
                  {r.linkLabel ?? 'Ver más'} <Arrow />
                </a>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .rows__head {
    display: grid;
    gap: var(--s-5);
    margin-bottom: var(--s-7);
  }

  .rows__title {
    max-width: 18ch;
  }

  .rows__intro {
    max-width: 44ch;
  }

  @media (min-width: 1024px) {
    .rows__head {
      grid-template-columns: 1.2fr 1fr;
      align-items: end;
      column-gap: var(--gap);
    }
  }

  .rows__list {
    display: grid;
    gap: var(--s-4);
  }

  .row {
    position: relative;
    display: grid;
    gap: var(--s-4);
    padding: clamp(1.4rem, 2.6vw, 2.4rem);
    border-radius: 28px;
    background: var(--c-surface);
    border: 1px solid var(--c-line);
    overflow: hidden;
    isolation: isolate;
    transition:
      transform var(--t-mid) var(--ease-out),
      border-color var(--t-mid) ease;
  }

  .row::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(420px circle at var(--mx, 0%) var(--my, 0%), color-mix(in srgb, var(--c-accent) 14%, transparent), transparent 65%);
    opacity: 0;
    transition: opacity 400ms ease;
  }

  .row:hover {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--c-accent) 40%, transparent);
  }

  .row:hover::before {
    opacity: 1;
  }

  .row__title {
    font-size: clamp(1.7rem, 1.2rem + 1.9vw, 2.9rem);
    letter-spacing: -0.045em;
    line-height: 1;
    max-width: 14ch;
  }

  .row__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--s-4);
  }

  .row__text {
    max-width: 48ch;
    font-size: var(--fs-lead);
    line-height: 1.45;
    color: var(--c-ink-soft);
  }

  .row__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .row__tags li {
    padding: 0.35rem 0.8rem;
    border-radius: var(--pill);
    background: color-mix(in srgb, var(--c-accent) 11%, transparent);
    color: var(--c-ink);
    font-size: 0.9rem;
    font-weight: 600;
  }

  .row__link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 44px;
    font-weight: 700;
    text-decoration: none;
  }

  .row__link :global(.arrow) {
    color: var(--c-accent);
    transition: transform var(--t-mid) var(--ease-out);
  }

  .row__link:hover :global(.arrow) {
    transform: translateX(5px);
  }

  @media (min-width: 900px) {
    .row {
      grid-template-columns: 5fr 7fr;
      column-gap: var(--gap);
    }
  }
</style>
