---
/** Contenedor de texto largo (páginas legales y de créditos). */
interface Props {
  title: string;
  intro?: string;
}
const { title, intro } = Astro.props;
---

<article class="prose-page">
  <header class="prose-page__head">
    <div class="prose-page__head-inner">
      <h1 id="titulo-pagina" class="t-head" data-split data-split-now>{title}</h1>
      {intro && <p class="prose-page__intro">{intro}</p>}
    </div>
  </header>
  <div class="wrap">
    <div class="prose">
      <slot />
    </div>
  </div>
</article>

<style>
  .prose-page {
    padding-block: 0 var(--section);
  }

  .prose-page__head {
    padding: calc(var(--header-h) + var(--s-9)) var(--margin) var(--s-8);
    margin-bottom: var(--s-8);
    background:
      radial-gradient(50% 80% at 90% 0%, rgb(124 58 237 / 0.4), transparent 70%),
      var(--night);
    color: #f4f1fb;
  }

  .prose-page__head-inner {
    max-width: var(--max);
    margin-inline: auto;
    display: grid;
    gap: var(--s-5);
  }

  .prose-page__intro {
    max-width: 44ch;
    font-size: var(--fs-lead);
    line-height: 1.45;
    color: #c9c2dc;
  }

  .prose {
    max-width: 70ch;
  }

  .prose :global(h2) {
    margin: var(--s-7) 0 var(--s-3);
    font-size: var(--fs-lead);
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .prose :global(h2:first-child) {
    margin-top: 0;
  }

  .prose :global(p),
  .prose :global(li) {
    line-height: 1.65;
    color: var(--c-ink-soft);
  }

  .prose :global(p + p) {
    margin-top: var(--s-4);
  }

  .prose :global(ul) {
    margin-top: var(--s-3);
    display: grid;
    gap: var(--s-2);
  }

  .prose :global(ul li) {
    position: relative;
    padding-left: 1.4rem;
  }

  .prose :global(ul li::before) {
    content: '';
    position: absolute;
    left: 0;
    top: 0.65em;
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--violet);
  }

  .prose :global(a) {
    color: var(--violet);
    font-weight: 600;
  }

  .prose :global(.pending) {
    padding: 0.1em 0.45em;
    border-radius: 6px;
    background: color-mix(in srgb, var(--c-error) 12%, transparent);
    color: var(--c-error);
    font-size: 0.92em;
    font-weight: 700;
  }
</style>
