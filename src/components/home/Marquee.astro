---
/**
 * Banda en movimiento con los servicios, separados por el "+" del logotipo.
 * Se detiene al pasar el cursor y con movimiento reducido.
 */
interface Props {
  items?: string[];
  tone?: 'violet' | 'dark' | 'gold';
  reverse?: boolean;
}
const {
  items = ['ChatGPT Ads', 'WhatsApp con IA', 'Google Ads', 'Automatización', 'Meta Ads', 'IA para tu negocio', 'Landing pages', 'SEO + visibilidad en IA', 'CRM', 'Contenido y redes'],
  tone = 'violet',
  reverse = false,
} = Astro.props;
---

<div class:list={['mq', `mq--${tone}`, reverse && 'mq--reverse']} aria-label="Servicios" role="region">
  <ul class="visually-hidden">
    {items.map((i) => <li>{i}</li>)}
  </ul>
  <div class="mq__track" aria-hidden="true">
    {
      [0, 1].map(() => (
        <div class="mq__group">
          {items.map((i) => (
            <span class="mq__item">
              {i}
              <span class="mq__sep">+</span>
            </span>
          ))}
        </div>
      ))
    }
  </div>
</div>

<style>
  .mq {
    position: relative;
    overflow: hidden;
    padding-block: clamp(1.1rem, 2.2vw, 1.8rem);
    background: var(--violet);
    color: #fff;
  }

  .mq--dark {
    background: var(--night);
  }

  .mq--gold {
    background: var(--gold);
    color: #16111f;
  }

  .mq__track {
    display: flex;
    width: max-content;
  }

  .mq__group {
    display: flex;
    flex: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .mq__track {
      animation: mq-move 38s linear infinite;
    }

    .mq--reverse .mq__track {
      animation-direction: reverse;
    }

    .mq:hover .mq__track {
      animation-play-state: paused;
    }
  }

  @keyframes mq-move {
    to {
      transform: translateX(-50%);
    }
  }

  .mq__item {
    display: inline-flex;
    align-items: center;
    gap: clamp(1rem, 2.4vw, 2.2rem);
    padding-right: clamp(1rem, 2.4vw, 2.2rem);
    font-size: clamp(1.6rem, 1rem + 2.6vw, 3.4rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
    white-space: nowrap;
  }

  .mq__sep {
    color: var(--gold);
    font-weight: 900;
  }

  .mq--gold .mq__sep {
    color: var(--violet);
  }
</style>
