---
/**
 * Campo de puntos interactivo: miles de partículas forman un texto (por defecto "IA")
 * y se apartan del cursor o del dedo; después vuelven a su lugar.
 * Canvas 2D, se pausa fuera de pantalla. Con movimiento reducido se dibuja quieto.
 */
interface Props {
  text?: string;
  class?: string;
  /** Texto para lectores de pantalla. */
  label?: string;
}
const { text = 'IA', class: className, label = 'Ilustración interactiva: puntos que forman las letras IA y reaccionan al movimiento.' } = Astro.props;
---

<div class:list={['pf', className]} data-particles={text} role="img" aria-label={label}>
  <canvas class="pf__canvas"></canvas>
  <p class="pf__hint" aria-hidden="true">Mueve el cursor sobre los puntos</p>
</div>

<script>
  type P = { x: number; y: number; tx: number; ty: number; vx: number; vy: number; gold: boolean; size: number };

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('[data-particles]').forEach((root) => {
    const canvas = root.querySelector('canvas')!;
    const ctx = canvas.getContext('2d')!;
    const text = root.dataset.particles || 'IA';
    let particles: P[] = [];
    let w = 0;
    let h = 0;
    let dpr = 1;
    let raf = 0;
    let visible = false;
    const mouse = { x: -9999, y: -9999, active: false };

    const build = () => {
      const rect = root.getBoundingClientRect();
      w = rect.width;
      h = rect.height;
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      canvas.style.width = `${w}px`;
      canvas.style.height = `${h}px`;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

      // Dibuja el texto en un lienzo oculto y toma muestras de sus píxeles.
      const off = document.createElement('canvas');
      off.width = Math.round(w);
      off.height = Math.round(h);
      const o = off.getContext('2d')!;
      const fontSize = Math.min(h * 0.82, (w / Math.max(text.length, 1)) * 1.25);
      o.fillStyle = '#fff';
      o.textAlign = 'center';
      o.textBaseline = 'middle';
      const family = getComputedStyle(document.body).fontFamily;
      o.font = `800 ${fontSize}px ${family}`;
      o.fillText(text, w / 2, h / 2 + fontSize * 0.04);
      const data = o.getImageData(0, 0, off.width, off.height).data;

      const small = w < 600;
      const gap = small ? 6 : Math.max(5, Math.round(Math.min(w, h) / 125));
      const targets: { x: number; y: number }[] = [];
      for (let y = 0; y < off.height; y += gap) {
        for (let x = 0; x < off.width; x += gap) {
          if (data[(y * off.width + x) * 4 + 3] > 128) targets.push({ x, y });
        }
      }

      particles = targets.map((t) => ({
        x: reduce ? t.x : Math.random() * w,
        y: reduce ? t.y : Math.random() * h,
        tx: t.x,
        ty: t.y,
        vx: 0,
        vy: 0,
        gold: Math.random() < 0.12,
        size: Math.random() < 0.1 ? 3 : 2.2,
      }));
    };

    const draw = () => {
      ctx.clearRect(0, 0, w, h);
      const radius = Math.min(w, h) * 0.16 + 40;
      const r2 = radius * radius;
      for (const p of particles) {
        let near = 0;
        if (!reduce) {
          let fx = (p.tx - p.x) * 0.045;
          let fy = (p.ty - p.y) * 0.045;
          if (mouse.active) {
            const dx = p.x - mouse.x;
            const dy = p.y - mouse.y;
            const d2 = dx * dx + dy * dy;
            if (d2 < r2) {
              const d = Math.sqrt(d2) || 1;
              near = 1 - d / radius;
              const force = near * 9;
              fx += (dx / d) * force;
              fy += (dy / d) * force;
            }
          }
          p.vx = (p.vx + fx) * 0.82;
          p.vy = (p.vy + fy) * 0.82;
          p.x += p.vx;
          p.y += p.vy;
        }
        const speed = Math.min(1, (Math.abs(p.vx) + Math.abs(p.vy)) / 6);
        const heat = Math.max(near, speed);
        if (p.gold || heat > 0.35) {
          ctx.fillStyle = `rgba(245,196,81,${0.8 + heat * 0.2})`;
        } else {
          ctx.fillStyle = `rgba(${167 + heat * 60},${139 + heat * 40},250,${0.7 + heat * 0.3})`;
        }
        const size = p.size + heat * 1.6;
        ctx.fillRect(p.x - size / 2, p.y - size / 2, size, size);
      }
    };

    const loop = () => {
      draw();
      raf = visible ? requestAnimationFrame(loop) : 0;
    };

    const start = () => {
      if (reduce) {
        draw();
        return;
      }
      if (!raf) raf = requestAnimationFrame(loop);
    };

    const setPointer = (clientX: number, clientY: number) => {
      const r = canvas.getBoundingClientRect();
      mouse.x = clientX - r.left;
      mouse.y = clientY - r.top;
      mouse.active = true;
    };

    root.addEventListener('pointermove', (e) => setPointer(e.clientX, e.clientY));
    root.addEventListener('pointerdown', (e) => setPointer(e.clientX, e.clientY));
    root.addEventListener('pointerleave', () => (mouse.active = false));
    root.addEventListener('pointerup', (e) => {
      if (e.pointerType !== 'mouse') mouse.active = false;
    });

    // Sin cursor (móvil): una "mano invisible" recorre el texto de vez en cuando.
    let idle = 0;
    const wander = () => {
      if (!visible || reduce) return;
      if (!root.matches(':hover')) {
        idle += 0.012;
        mouse.x = w * (0.5 + 0.38 * Math.sin(idle * 1.3));
        mouse.y = h * (0.5 + 0.3 * Math.sin(idle * 2.1));
        mouse.active = Math.sin(idle * 0.7) > 0.2;
      }
      requestAnimationFrame(wander);
    };

    document.fonts?.ready.then(() => {
      build();
      new IntersectionObserver((entries) => {
        visible = entries[0].isIntersecting;
        if (visible) {
          start();
          wander();
        }
      }).observe(root);
    });

    let resizeTimer = 0;
    new ResizeObserver(() => {
      clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => {
        build();
        if (reduce) draw();
      }, 150);
    }).observe(root);
  });
</script>

<style>
  .pf {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 18rem;
    touch-action: pan-y;
    cursor: crosshair;
  }

  .pf__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .pf__hint {
    position: absolute;
    right: 0.5rem;
    bottom: 0.5rem;
    padding: 0.35rem 0.75rem;
    border-radius: var(--pill);
    background: rgb(255 255 255 / 0.08);
    border: 1px solid rgb(255 255 255 / 0.12);
    color: #c9c2dc;
    font-size: 0.8rem;
    font-weight: 600;
    pointer-events: none;
  }

  @media (hover: none) {
    .pf__hint {
      display: none;
    }
  }
</style>
