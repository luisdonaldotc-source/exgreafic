---
import Wordmark from '@/components/ui/Wordmark.astro';
import Arrow from '@/components/ui/Arrow.astro';
import { site, whatsappHref } from '@/config/site';
import { families, servicesByFamily, type Family } from '@/content/services';

const year = new Date().getFullYear();
const wa = whatsappHref('Hola, quiero platicar sobre un proyecto.');
---

<footer class="ft" data-theme="dark">
  <div class="wrap">
    <div class="ft__cta">
      <p class="ft__cta-title">¿Tienes un problema, un objetivo o una idea?</p>
      <a class="btn btn--gold" href="/contacto/" data-magnetic="0.2">
        <span>Hablemos de tu proyecto</span>
        <span class="btn__arrow"><Arrow /></span>
      </a>
    </div>

    <div class="ft__grid">
      <div class="ft__contact">
        <p class="ft__lead">No necesitas saber qué servicio pedir. Empezamos por entender lo que quieres lograr.</p>
        <ul class="ft__direct">
          {site.contact.email && (
            <li>
              <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
            </li>
          )}
          {wa && (
            <li>
              <a href={wa} rel="noopener">WhatsApp</a>
            </li>
          )}
          {site.contact.phone && (
            <li>
              <a href={`tel:${site.contact.phone.replace(/\s/g, '')}`}>{site.contact.phone}</a>
            </li>
          )}
          {site.contact.city && <li class="ft__city">{site.contact.city}</li>}
        </ul>
      </div>

      <nav class="ft__nav" aria-label="Mapa del sitio">
        {
          families.map((f) => (
            <div class="ft__col">
              <a class="ft__col-title" href={f.path}>
                {f.name}
              </a>
              <ul>
                {servicesByFamily(f.id as Family).map((s) => (
                  <li>
                    <a href={s.path}>{s.name}</a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
        <div class="ft__col">
          <p class="ft__col-title">Empresa</p>
          <ul>
            <li><a href="/nosotros/">Nosotros</a></li>
            <li><a href="/contacto/">Contacto</a></li>
            {site.social.map((s) => (
              <li>
                <a href={s.href} rel="me noopener">{s.label}</a>
              </li>
            ))}
            <li><a href="/aviso-de-privacidad/">Aviso de privacidad</a></li>
            <li><a href="/creditos/">Créditos</a></li>
          </ul>
        </div>
      </nav>
    </div>

    <a class="ft__mark" href="/" aria-label={`${site.name}, inicio`}>
      <Wordmark />
    </a>

    <p class="ft__legal">
      <span>© {year} {site.name}</span>
      <span>Videos de Mixkit. <a href="/creditos/">Créditos</a>.</span>
    </p>
  </div>
</footer>

<style>
  .ft {
    position: relative;
    padding-block: var(--s-9) var(--s-5);
    overflow: hidden;
    isolation: isolate;
  }

  .ft::before {
    content: '';
    position: absolute;
    inset: auto -10% -40% -10%;
    height: 80%;
    z-index: -1;
    background: radial-gradient(50% 60% at 50% 100%, rgb(124 58 237 / 0.35), transparent 70%);
  }

  .ft__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--s-6);
    padding-bottom: var(--s-8);
    margin-bottom: var(--s-8);
    border-bottom: 1px solid rgb(255 255 255 / 0.1);
  }

  .ft__cta-title {
    max-width: 18ch;
    font-size: clamp(2rem, 1.3rem + 3vw, 4rem);
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 1;
  }

  .ft__grid {
    display: grid;
    gap: var(--s-8);
  }

  .ft__contact {
    display: grid;
    gap: var(--s-4);
    align-content: start;
  }

  .ft__lead {
    max-width: 30ch;
    font-size: var(--fs-lead);
    line-height: 1.4;
    color: #d5cfe5;
  }

  .ft__direct a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 700;
  }

  .ft__city {
    color: #a9a2bf;
  }

  .ft__nav {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-7) var(--gap);
  }

  .ft__col-title {
    display: inline-block;
    margin-bottom: var(--s-3);
    font-weight: 700;
    color: #fff;
    text-decoration: none;
  }

  a.ft__col-title:hover {
    color: var(--gold);
  }

  .ft__col ul {
    display: grid;
  }

  .ft__col li a {
    display: inline-block;
    padding-block: 0.38rem;
    font-size: 0.95rem;
    line-height: 1.35;
    color: #a9a2bf;
    text-decoration: none;
    transition:
      color var(--t-fast) ease,
      transform var(--t-mid) var(--ease-out);
  }

  .ft__col li a:hover {
    color: #fff;
    transform: translateX(4px);
  }

  .ft__mark {
    display: block;
    margin-top: var(--s-9);
    font-size: clamp(3rem, 13.4vw, 15.5rem);
    line-height: 0.8;
    text-decoration: none;
    background: linear-gradient(95deg, #fff 0%, var(--violet-200) 45%, var(--gold) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .ft__mark :global(.wordmark) {
    letter-spacing: -0.06em;
  }

  .ft__mark :global(.wordmark__plus) {
    color: var(--gold);
    -webkit-text-fill-color: var(--gold);
  }

  .ft__legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--s-2) var(--s-6);
    margin-top: var(--s-6);
    font-size: var(--fs-small);
    color: #a9a2bf;
  }

  .ft__legal a {
    color: #fff;
  }

  @media (min-width: 768px) {
    .ft__nav {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 1100px) {
    .ft__grid {
      grid-template-columns: 4fr 8fr;
    }
  }
</style>
