---
/**
 * Navegación flotante: logotipo, cápsula de vidrio con indicador que se desliza,
 * menús desplegables con una tarjeta destacada por área y una sola acción.
 * En móvil: panel a pantalla completa con categorías progresivas.
 */
import Wordmark from '@/components/ui/Wordmark.astro';
import Arrow from '@/components/ui/Arrow.astro';
import { families, servicesByFamily, type Family } from '@/content/services';

interface Props {
  active?: string;
}
const { active } = Astro.props;

const featured: Record<string, { kicker: string; title: string; href: string; video: string; poster: string }> = {
  ia: {
    kicker: 'En vivo',
    title: 'Mira un asistente de WhatsApp atender una conversación',
    href: '/inteligencia-artificial/whatsapp-con-ia/',
    video: 'atardecer-960',
    poster: 'atardecer-poster',
  },
  publicidad: {
    kicker: 'Novedad',
    title: 'ChatGPT Ads ya está disponible en México',
    href: '/publicidad/chatgpt-ads/',
    video: 'ciudad-960',
    poster: 'ciudad-poster',
  },
  contenido: {
    kicker: 'Idea',
    title: 'Un webinar puede convertirse en seis piezas distintas',
    href: '/estrategia-y-contenido/#reutilizar-titulo',
    video: 'atardecer-960',
    poster: 'atardecer-poster',
  },
  web: {
    kicker: 'Cómo funciona',
    title: 'Así se conectan página, WhatsApp, CRM y seguimiento',
    href: '/web-y-automatizacion/#flujo-titulo',
    video: 'glorieta-1280',
    poster: 'glorieta-poster',
  },
};

const menus = families.map((f) => {
  const items = servicesByFamily(f.id as Family);
  return { ...f, items, feature: featured[f.id] };
});
---

<header class="hdr" data-header>
  <div class="hdr__bar">
    <a class="hdr__brand" href="/">
      <Wordmark />
    </a>

    <nav class="hdr__nav" aria-label="Principal" data-nav>
      <span class="hdr__indicator" aria-hidden="true" data-nav-indicator></span>
      <ul class="hdr__list">
        {
          menus.map((m) => (
            <li>
              <button
                class="hdr__item"
                type="button"
                aria-expanded="false"
                aria-controls={`mega-${m.id}`}
                data-mega-trigger={m.id}
                data-nav-item
                aria-current={active === m.id ? 'true' : undefined}
              >
                {m.name}
                <svg class="hdr__chev" width="10" height="6" viewBox="0 0 10 6" aria-hidden="true">
                  <path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6" />
                </svg>
              </button>
            </li>
          ))
        }
        <li>
          <a class="hdr__item" href="/nosotros/" data-nav-item aria-current={active === 'nosotros' ? 'page' : undefined}>
            Nosotros
          </a>
        </li>
      </ul>
    </nav>

    <div class="hdr__actions">
      <a class="btn btn--gold btn--plain hdr__cta" href="/contacto/" data-magnetic="0.25">Hablemos</a>
      <button class="hdr__burger" type="button" aria-expanded="false" aria-controls="menu-movil" data-menu-toggle>
        <span class="visually-hidden menu-toggle__label" data-label-closed="Abrir menú" data-label-open="Cerrar menú"
          >Abrir menú</span
        >
        <span class="hdr__burger-lines" aria-hidden="true"><span></span><span></span></span>
      </button>
    </div>
  </div>

  {
    menus.map((m) => (
      <div class="mega" id={`mega-${m.id}`} data-mega={m.id}>
        <div class="mega__panel">
          <div class="mega__intro">
            <p class="mega__title">{m.name}</p>
            <p class="mega__summary">{m.summary}</p>
            <a class="mega__hub" href={m.path}>
              {m.hubLink} <Arrow />
            </a>
          </div>
          <ul class="mega__links">
            {m.items.map((s) => (
              <li>
                <a class="mega__link" href={s.path}>
                  <span class="mega__link-name">{s.name}</span>
                  <span class="mega__link-summary">{s.summary}</span>
                </a>
              </li>
            ))}
          </ul>
          <a class="mega__feature" href={m.feature.href}>
            <video
              class="mega__video"
              muted
              loop
              playsinline
              preload="none"
              poster={`/video/${m.feature.poster}.jpg`}
              data-mega-video
              aria-hidden="true"
            >
              <source src={`/video/${m.feature.video}.mp4`} type="video/mp4" />
            </video>
            <span class="mega__feature-body">
              <span class="mega__feature-kicker">{m.feature.kicker}</span>
              <span class="mega__feature-title">{m.feature.title}</span>
            </span>
          </a>
        </div>
      </div>
    ))
  }

  <div class="mobile" id="menu-movil" data-mobile-menu>
    <nav class="mobile__inner" aria-label="Principal (móvil)">
      <ul class="mobile__list">
        <li class="mobile__row"><a class="mobile__top" href="/">Inicio</a></li>
        {
          menus.map((m) => (
            <li class="mobile__row">
              <button
                class="mobile__top mobile__toggle"
                type="button"
                aria-expanded="false"
                aria-controls={`movil-${m.id}`}
                data-accordion
              >
                {m.name}
                <span class="mobile__sign" aria-hidden="true" />
              </button>
              <div class="mobile__panel" id={`movil-${m.id}`} hidden>
                <ul>
                  <li>
                    <a class="mobile__sub mobile__sub--hub" href={m.path}>
                      {m.hubLink} <Arrow />
                    </a>
                  </li>
                  {m.items.map((s) => (
                    <li>
                      <a class="mobile__sub" href={s.path}>
                        {s.name}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </li>
          ))
        }
        <li class="mobile__row"><a class="mobile__top" href="/nosotros/">Nosotros</a></li>
        <li class="mobile__row"><a class="mobile__top" href="/contacto/">Contacto</a></li>
      </ul>
      <a class="btn btn--gold mobile__cta" href="/contacto/">
        <span>Cuéntanos qué quieres mejorar</span>
        <span class="btn__arrow"><Arrow /></span>
      </a>
    </nav>
  </div>
</header>
<div class="mega-scrim" data-mega-scrim aria-hidden="true"></div>

<style>
  .hdr {
    position: fixed;
    inset: 0 0 auto;
    z-index: 60;
    padding: 0.85rem var(--margin) 0;
    pointer-events: none;
    transition: transform var(--t-mid) var(--ease-out);
  }

  :global(html.header-hidden) .hdr {
    transform: translateY(-120%);
  }

  .hdr__bar {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    max-width: calc(var(--max) - 2 * var(--margin));
    min-height: 3.6rem;
    margin-inline: auto;
    padding: 0.4rem 0.45rem 0.4rem 1.1rem;
    border-radius: var(--pill);
    color: #f4f1fb;
    border: 1px solid transparent;
    pointer-events: auto;
    transition:
      background-color var(--t-mid) ease,
      border-color var(--t-mid) ease,
      box-shadow var(--t-mid) ease;
  }

  /* Al bajar, toda la barra se vuelve una cápsula de vidrio. */
  :global(html.is-scrolled) .hdr__bar,
  :global(html.mega-open) .hdr__bar,
  :global(html.menu-open) .hdr__bar {
    background: rgb(14 11 22 / 0.72);
    -webkit-backdrop-filter: blur(20px) saturate(160%);
    backdrop-filter: blur(20px) saturate(160%);
    border-color: rgb(255 255 255 / 0.1);
    box-shadow: 0 20px 50px -25px rgb(0 0 0 / 0.6); /* taste-skill-ignore: barra flotante */
  }

  .hdr__brand {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 1.2rem;
    text-decoration: none;
    color: inherit;
  }

  /* ---------- Cápsula central ---------- */
  .hdr__nav {
    position: absolute;
    left: 50%;
    top: 50%;
    display: none;
    padding: 0.3rem;
    border-radius: var(--pill);
    background: rgb(255 255 255 / 0.07);
    border: 1px solid rgb(255 255 255 / 0.12);
    -webkit-backdrop-filter: blur(16px) saturate(150%);
    backdrop-filter: blur(16px) saturate(150%);
    transform: translate(-50%, -50%);
  }

  .hdr__list {
    position: relative;
    display: flex;
    align-items: center;
  }

  .hdr__indicator {
    position: absolute;
    top: 0.3rem;
    left: 0;
    height: calc(100% - 0.6rem);
    width: 0;
    border-radius: var(--pill);
    background: rgb(255 255 255 / 0.13);
    opacity: 0;
    transition:
      transform 420ms var(--ease-out),
      width 420ms var(--ease-out),
      opacity 220ms ease;
    pointer-events: none;
  }

  .hdr__item {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.6rem;
    padding: 0 1rem;
    border-radius: var(--pill);
    font-size: 0.95rem;
    font-weight: 600;
    color: rgb(244 241 251 / 0.86);
    text-decoration: none;
    white-space: nowrap;
    transition: color var(--t-fast) ease;
  }

  .hdr__item:hover,
  .hdr__item[aria-expanded='true'] {
    color: #ffffff;
  }

  .hdr__item[aria-current]::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 0.25rem;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--gold);
    transform: translateX(-50%);
  }

  .hdr__chev {
    opacity: 0.7;
    transition: transform var(--t-mid) var(--ease-out);
  }

  .hdr__item[aria-expanded='true'] .hdr__chev {
    transform: rotate(180deg);
  }

  .hdr__actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .hdr__cta {
    min-height: 2.75rem;
    padding-inline: 1.3rem;
    font-size: 0.95rem;
  }

  @media (min-width: 1180px) {
    .hdr__nav {
      display: block;
    }
  }

  @media (max-width: 479px) {
    .hdr__cta {
      display: none;
    }
  }

  /* ---------- Botón de menú ---------- */
  .hdr__burger {
    display: inline-grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.1);
    border: 1px solid rgb(255 255 255 / 0.14);
    transition: background-color var(--t-fast) ease;
  }

  .hdr__burger:hover {
    background: rgb(255 255 255 / 0.18);
  }

  .hdr__burger-lines {
    position: relative;
    width: 18px;
    height: 10px;
  }

  .hdr__burger-lines span {
    position: absolute;
    left: 0;
    width: 100%;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
    transition:
      transform var(--t-mid) var(--ease-out),
      top var(--t-mid) var(--ease-out);
  }

  .hdr__burger-lines span:first-child {
    top: 0;
  }

  .hdr__burger-lines span:last-child {
    top: 8px;
  }

  .hdr__burger[aria-expanded='true'] .hdr__burger-lines span:first-child {
    top: 4px;
    transform: rotate(45deg);
  }

  .hdr__burger[aria-expanded='true'] .hdr__burger-lines span:last-child {
    top: 4px;
    transform: rotate(-45deg);
  }

  @media (min-width: 1180px) {
    .hdr__burger {
      display: none;
    }
  }

  /* ---------- Menús desplegables ---------- */
  .mega {
    position: absolute;
    top: calc(100% + 0.6rem);
    left: 50%;
    width: min(1080px, calc(100vw - 2 * var(--margin)));
    pointer-events: none;
    visibility: hidden;
    opacity: 0;
    transform: translate(-50%, -10px) scale(0.985);
    transform-origin: top center;
    transition:
      opacity var(--t-mid) var(--ease-out),
      transform var(--t-mid) var(--ease-out),
      visibility 0s linear var(--t-mid);
  }

  .mega[data-open] {
    pointer-events: auto;
    visibility: visible;
    opacity: 1;
    transform: translate(-50%, 0) scale(1);
    transition:
      opacity var(--t-mid) var(--ease-out),
      transform var(--t-mid) var(--ease-out),
      visibility 0s;
  }

  .mega__panel {
    display: grid;
    grid-template-columns: 1fr 1.5fr 1fr;
    gap: var(--s-6);
    padding: var(--s-6);
    border-radius: 28px;
    color: #f4f1fb;
    background: rgb(16 13 25 / 0.94);
    -webkit-backdrop-filter: blur(24px) saturate(160%);
    backdrop-filter: blur(24px) saturate(160%);
    border: 1px solid rgb(255 255 255 / 0.1);
    box-shadow: 0 40px 90px -40px rgb(0 0 0 / 0.8); /* taste-skill-ignore: menú flotante */
  }

  .mega__intro,
  .mega__links > li,
  .mega__feature {
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity 420ms var(--ease-out),
      transform 420ms var(--ease-out);
  }

  .mega[data-open] .mega__intro,
  .mega[data-open] .mega__links > li,
  .mega[data-open] .mega__feature {
    opacity: 1;
    transform: none;
  }

  .mega[data-open] .mega__links > li:nth-child(1) { transition-delay: 40ms; }
  .mega[data-open] .mega__links > li:nth-child(2) { transition-delay: 70ms; }
  .mega[data-open] .mega__links > li:nth-child(3) { transition-delay: 100ms; }
  .mega[data-open] .mega__links > li:nth-child(4) { transition-delay: 130ms; }
  .mega[data-open] .mega__links > li:nth-child(5) { transition-delay: 160ms; }
  .mega[data-open] .mega__links > li:nth-child(6) { transition-delay: 190ms; }
  .mega[data-open] .mega__links > li:nth-child(7) { transition-delay: 220ms; }
  .mega[data-open] .mega__feature { transition-delay: 120ms; }

  .mega__intro {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--s-3);
  }

  .mega__title {
    font-size: 1.6rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }

  .mega__summary {
    color: #b9b2cf;
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .mega__hub {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: auto;
    min-height: 40px;
    color: var(--gold);
    font-weight: 700;
    text-decoration: none;
  }

  .mega__hub:hover :global(.arrow) {
    transform: translateX(4px);
  }

  .mega__links {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.15rem 0.5rem;
    align-content: start;
  }

  .mega__link {
    display: block;
    padding: 0.7rem 0.85rem;
    border-radius: 14px;
    text-decoration: none;
    transition: background-color var(--t-fast) ease;
  }

  .mega__link:hover,
  .mega__link:focus-visible {
    background: rgb(255 255 255 / 0.07);
  }

  .mega__link-name {
    display: block;
    font-weight: 700;
    font-size: 0.98rem;
    line-height: 1.25;
  }

  .mega__link-summary {
    display: block;
    margin-top: 0.15rem;
    color: #a9a2bf;
    font-size: 0.85rem;
    line-height: 1.4;
  }

  .mega__feature {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: 15rem;
    overflow: hidden;
    border-radius: 20px;
    text-decoration: none;
    isolation: isolate;
  }

  .mega__video {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s var(--ease-out);
  }

  .mega__feature::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(180deg, rgb(11 9 18 / 0) 20%, rgb(11 9 18 / 0.88) 100%),
      linear-gradient(135deg, rgb(124 58 237 / 0.5), transparent 60%);
  }

  .mega__feature:hover .mega__video {
    transform: scale(1.06);
  }

  .mega__feature-body {
    display: grid;
    gap: 0.4rem;
    padding: var(--s-5);
  }

  .mega__feature-kicker {
    justify-self: start;
    padding: 0.2rem 0.6rem;
    border-radius: var(--pill);
    background: var(--gold);
    color: #16111f;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .mega__feature-title {
    font-weight: 700;
    font-size: 1.05rem;
    line-height: 1.3;
  }

  .mega-scrim {
    position: fixed;
    inset: 0;
    z-index: 50;
    background: rgb(11 9 18 / 0.45);
    -webkit-backdrop-filter: blur(3px);
    backdrop-filter: blur(3px);
    opacity: 0;
    visibility: hidden;
    transition:
      opacity var(--t-mid) ease,
      visibility 0s linear var(--t-mid);
  }

  :global(html.mega-open) .mega-scrim {
    opacity: 1;
    visibility: visible;
    transition: opacity var(--t-mid) ease;
  }

  /* ---------- Menú móvil ---------- */
  .mobile {
    position: fixed;
    inset: 0;
    z-index: -1;
    padding: calc(var(--header-h) + 0.5rem) var(--margin) var(--s-6);
    overflow-y: auto;
    overscroll-behavior: contain;
    background: var(--night);
    color: #f4f1fb;
    pointer-events: none;
    visibility: hidden;
    clip-path: circle(0% at calc(100% - 3rem) 2.6rem);
    transition:
      clip-path 700ms var(--ease-out),
      visibility 0s linear 700ms;
  }

  .mobile::before {
    content: '';
    position: fixed;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(70% 50% at 100% 0%, rgb(124 58 237 / 0.35), transparent 70%),
      radial-gradient(60% 40% at 0% 100%, rgb(245 196 81 / 0.12), transparent 70%);
  }

  .mobile[data-open] {
    pointer-events: auto;
    visibility: visible;
    clip-path: circle(150% at calc(100% - 3rem) 2.6rem);
    transition:
      clip-path 700ms var(--ease-out),
      visibility 0s;
  }

  .mobile__inner {
    display: flex;
    flex-direction: column;
    gap: var(--s-6);
    min-height: 100%;
  }

  .mobile__row {
    opacity: 0;
    transform: translateY(18px);
    transition:
      opacity 500ms var(--ease-out),
      transform 500ms var(--ease-out);
  }

  .mobile[data-open] .mobile__row {
    opacity: 1;
    transform: none;
  }

  .mobile[data-open] .mobile__row:nth-child(2) { transition-delay: 60ms; }
  .mobile[data-open] .mobile__row:nth-child(3) { transition-delay: 100ms; }
  .mobile[data-open] .mobile__row:nth-child(4) { transition-delay: 140ms; }
  .mobile[data-open] .mobile__row:nth-child(5) { transition-delay: 180ms; }
  .mobile[data-open] .mobile__row:nth-child(6) { transition-delay: 220ms; }
  .mobile[data-open] .mobile__row:nth-child(7) { transition-delay: 260ms; }

  .mobile__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    min-height: 3.6rem;
    font-size: clamp(1.6rem, 1.2rem + 2vw, 2.2rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.1;
    text-align: left;
    text-decoration: none;
    border-bottom: 1px solid rgb(255 255 255 / 0.08);
  }

  .mobile__sign {
    position: relative;
    width: 14px;
    height: 14px;
    flex: none;
  }

  .mobile__sign::before,
  .mobile__sign::after {
    content: '';
    position: absolute;
    top: 6px;
    left: 0;
    width: 14px;
    height: 2px;
    border-radius: 2px;
    background: var(--gold);
    transition: transform var(--t-mid) var(--ease-out);
  }

  .mobile__sign::after {
    transform: rotate(90deg);
  }

  .mobile__toggle[aria-expanded='true'] .mobile__sign::after {
    transform: rotate(0deg);
  }

  .mobile__panel ul {
    padding: var(--s-3) 0 var(--s-4);
  }

  .mobile__sub {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.75rem;
    color: #c9c2dc;
    text-decoration: none;
  }

  .mobile__sub--hub {
    color: var(--gold);
    font-weight: 700;
  }

  .mobile__cta {
    margin-top: auto;
    justify-content: space-between;
  }

  @media (min-width: 1180px) {
    .mobile {
      display: none;
    }
  }
</style>
